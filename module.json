      {"key":"perc_normal_level","name":"Normal Level","min":0.0,"max":1.0,"default":1.0},
      {"key":"perc_soft_level","name":"Soft Level","min":0.0,"max":0.89125,"default":0.5012},
      {"key":"perc_gain","name":"Percussion Gain","min":0.0,"max":22.0,"default":11.0},
      {"key":"vibrato_upper_mode","name":"Vibrato Upper","options":["V3","V2","V1","OFF","C1","C2","C3"],"default":3},
      {"key":"vibrato_lower_mode","name":"Vibrato Lower","options":["V3","V2","V1","OFF","C1","C2","C3"],"default":3},
      {"key":"compartment_crosstalk","name":"Compartment Crosstalk","min":0.0,"max":1.0,"default":0.01,"dynamic_display":true},
      {"key":"transformer_crosstalk","name":"Transformer Crosstalk","min":0.0,"max":1.0,"default":0.0,"dynamic_display":true},
      {"key":"terminal_crosstalk","name":"Terminal Crosstalk","min":0.0,"max":1.0,"default":0.01,"dynamic_display":true},
      {"key":"wiring_crosstalk","name":"Wiring Crosstalk","min":0.0,"max":1.0,"default":0.01,"dynamic_display":true},

      {"key":"horn_slow_speed","name":"Horn Slow Speed","min":5.0,"max":200.0,"default":40.32,"unit":"RPM","dynamic_display":true},
      {"key":"horn_fast_speed","name":"Horn Fast Speed","min":100.0,"max":900.0,"default":423.36,"unit":"RPM","dynamic_display":true},
      {"key":"drum_slow_speed","name":"Drum Slow Speed","min":5.0,"max":100.0,"default":36.0,"unit":"RPM","dynamic_display":true},
      {"key":"drum_fast_speed","name":"Drum Fast Speed","min":60.0,"max":600.0,"default":357.3,"unit":"RPM","dynamic_display":true},
      {"key":"horn_acceleration","name":"Horn Acceleration","min":0.05,"max":2.0,"default":0.161,"unit":"s","dynamic_display":true},
      {"key":"horn_deceleration","name":"Horn Deceleration","min":0.05,"max":2.0,"default":0.321,"unit":"s","dynamic_display":true},
      {"key":"drum_acceleration","name":"Drum Acceleration","min":0.5,"max":10.0,"default":4.127,"unit":"s","dynamic_display":true},
      {"key":"drum_deceleration","name":"Drum Deceleration","min":0.5,"max":10.0,"default":1.371,"unit":"s","dynamic_display":true},
      {"key":"attack_click_level","name":"Attack Click Level","min":0.0,"max":1.0,"default":0.5,"dynamic_display":true},
      {"key":"release_click_level","name":"Release Click Level","min":0.0,"max":1.0,"default":0.25,"dynamic_display":true},
      {"key":"click_min_length","name":"Click Min Length","min":0.0,"max":1.0,"default":0.125,"dynamic_display":true},
      {"key":"click_max_length","name":"Click Max Length","min":0.0,"max":1.0,"default":0.625,"dynamic_display":true},
      {"key":"scanner_rate","name":"Scanner Rate","min":4.0,"max":22.0,"default":7.25,"unit":"Hz","dynamic_display":true},
      {"key":"scanner_v1_depth","name":"V1 Depth","min":0.0,"max":12.0,"default":3.0,"dynamic_display":true},
      {"key":"scanner_v2_depth","name":"V2 Depth","min":0.0,"max":12.0,"default":6.0,"dynamic_display":true},
      {"key":"scanner_v3_depth","name":"V3 Depth","min":0.0,"max":12.0,"default":9.0,"dynamic_display":true},
