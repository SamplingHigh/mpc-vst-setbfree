      {"key":"vibrato_lower","name":"Vibrato Lower","options":["Off","On"],"default":0},
      {"key":"swell","name":"Swell","min":0,"max":100,"default":100,"display":"int","unit":"%"},
      {"key":"rotary","name":"Rotary","options":["Stop","Slow","Fast"],"default":1},
      {"key":"overdrive","name":"Overdrive","options":["Off","On"],"default":0},
      {"key":"drive_character","name":"Drive Character","min":0,"max":100,"default":50,"display":"int","unit":"%"},
      {"key":"drive_input","name":"Drive Input","min":0,"max":100,"default":50,"display":"int","unit":"%"},
      {"key":"drive_output","name":"Drive Output","min":0,"max":100,"default":50,"display":"int","unit":"%"},
      {"key":"reverb","name":"Reverb","min":0,"max":100,"default":10,"display":"int","unit":"%"},

