{
  "id": "setbfree",
  "name": "setBfree Organ",
  "abbrev": "B3",
  "version": "0.3.0",
  "description": "Tonewheel organ with overdrive, reverb, rotary speaker and optional one-keyboard manual splits",
  "author": "setBfree contributors; MPC VST port Force Runtime",
  "dsp": "dsp.so",
  "api_version": 2,
  "capabilities": {
    "audio_out": true,
    "audio_in": false,
    "midi_in": true,
    "midi_out": false,
    "chainable": true,
    "component_type": "sound_generator",
    "chain_params": [
