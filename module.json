{
  "id": "setbfree",
  "name": "setBfree Organ",
  "abbrev": "B3",
  "version": "0.1.12",
  "description": "Tonewheel organ with overdrive, reverb, rotary speaker and optional one-keyboard manual splits",
  "author": "setBfree contributors; MPC VST port Force Runtime",
  "dsp": "dsp.so",
  "api_version": 2,
  "capabilities": {
    "audio_out": true,
    "audio_in": false,
    "midi_in": true,
    "midi_out": false,
    "chainable": true,
    "component_type": "sound_generator",
    "chain_params": [
      {"key":"split_mode","name":"Split Mode","options":["Upper","Upper+Lower","Upper+Lower+Pedal"],"default":0},
      {"key":"pedal_split","name":"Pedal Split","min":24,"max":95,"default":36,"display":"int"},
      {"key":"upper_split","name":"Upper Split","min":25,"max":96,"default":60,"display":"int"},

      {"key":"upper_16","name":"Upper 16'","min":0,"max":8,"default":8,"display":"int"},
      {"key":"upper_5_13","name":"Upper 5 1/3'","min":0,"max":8,"default":8,"display":"int"},
      {"key":"upper_8","name":"Upper 8'","min":0,"max":8,"default":6,"display":"int"},
      {"key":"upper_4","name":"Upper 4'","min":0,"max":8,"default":0,"display":"int"},
      {"key":"upper_2_23","name":"Upper 2 2/3'","min":0,"max":8,"default":0,"display":"int"},
      {"key":"upper_2","name":"Upper 2'","min":0,"max":8,"default":0,"display":"int"},
      {"key":"upper_1_35","name":"Upper 1 3/5'","min":0,"max":8,"default":0,"display":"int"},
      {"key":"upper_1_13","name":"Upper 1 1/3'","min":0,"max":8,"default":0,"display":"int"},
      {"key":"upper_1","name":"Upper 1'","min":0,"max":8,"default":0,"display":"int"},

      {"key":"lower_16","name":"Lower 16'","min":0,"max":8,"default":0,"display":"int"},
      {"key":"lower_5_13","name":"Lower 5 1/3'","min":0,"max":8,"default":5,"display":"int"},
      {"key":"lower_8","name":"Lower 8'","min":0,"max":8,"default":0,"display":"int"},
      {"key":"lower_4","name":"Lower 4'","min":0,"max":8,"default":8,"display":"int"},
      {"key":"lower_2_23","name":"Lower 2 2/3'","min":0,"max":8,"default":8,"display":"int"},
      {"key":"lower_2","name":"Lower 2'","min":0,"max":8,"default":8,"display":"int"},
      {"key":"lower_1_35","name":"Lower 1 3/5'","min":0,"max":8,"default":8,"display":"int"},
      {"key":"lower_1_13","name":"Lower 1 1/3'","min":0,"max":8,"default":8,"display":"int"},
      {"key":"lower_1","name":"Lower 1'","min":0,"max":8,"default":8,"display":"int"},

      {"key":"pedal_16","name":"Pedal 16'","min":0,"max":8,"default":0,"display":"int"},
      {"key":"pedal_5_13","name":"Pedal 5 1/3'","min":0,"max":8,"default":0,"display":"int"},
      {"key":"pedal_8","name":"Pedal 8'","min":0,"max":8,"default":2,"display":"int"},
      {"key":"pedal_4","name":"Pedal 4'","min":0,"max":8,"default":0,"display":"int"},
      {"key":"pedal_2_23","name":"Pedal 2 2/3'","min":0,"max":8,"default":0,"display":"int"},
      {"key":"pedal_2","name":"Pedal 2'","min":0,"max":8,"default":0,"display":"int"},
      {"key":"pedal_1_35","name":"Pedal 1 3/5'","min":0,"max":8,"default":0,"display":"int"},
      {"key":"pedal_1_13","name":"Pedal 1 1/3'","min":0,"max":8,"default":0,"display":"int"},
      {"key":"pedal_1","name":"Pedal 1'","min":0,"max":8,"default":0,"display":"int"},

      {"key":"percussion","name":"Percussion","options":["Off","On"],"default":0},
      {"key":"perc_volume","name":"Perc Volume","options":["Soft","Normal"],"default":1},
      {"key":"perc_decay","name":"Perc Decay","options":["Fast","Slow"],"default":0},
      {"key":"perc_harmonic","name":"Perc Harmonic","options":["2nd","3rd"],"default":1},
      {"key":"vibrato","name":"Vibrato","options":["Off","V1","C1","V2","C2","V3","C3"],"default":0},
      {"key":"vibrato_upper","name":"Vibrato Upper","options":["Off","On"],"default":0},
      {"key":"vibrato_lower","name":"Vibrato Lower","options":["Off","On"],"default":0},
      {"key":"swell","name":"Swell","min":0,"max":100,"default":100,"display":"int","unit":"%"},
      {"key":"rotary","name":"Rotary","options":["Stop","Slow","Fast"],"default":1},
      {"key":"overdrive","name":"Overdrive","options":["Off","On"],"default":0},
      {"key":"drive_character","name":"Drive Character","min":0,"max":100,"default":50,"display":"int","unit":"%"},
      {"key":"drive_input","name":"Drive Input","min":0,"max":100,"default":50,"display":"int","unit":"%"},
      {"key":"drive_output","name":"Drive Output","min":0,"max":100,"default":50,"display":"int","unit":"%"},
      {"key":"reverb","name":"Reverb","min":0,"max":100,"default":10,"display":"int","unit":"%"}
    ]
  }
}
